#!/bin/bash

source /usr/local/JSBach/scripts/utils/variables.conf
	

MSG="[ wan ]" # nou_comand
MSG_ERROR="Error: opcio desconeguda falta $MSG"

read ordre
ordre=${ordre%$'\r'}   # telnet envia \r\n
if [[ -n $ordre ]]; then
	Comando=$(echo "$ordre" | awk '{print $1}')
	Arguments=$(echo "$ordre" | awk '{for (i=2; i<=NF; ++i)  printf "%s ", $i }')

	case "$Comando" in
	"prompt")
		echo "$PROMPT""_v""$VERSIO"
		;;
	"wan")
		"$DIR_WAN/wan" $Arguments
		;;
	"lan")
		"$DIR_LAN/lan" $Arguments
		;;
	#nova funcio
	"help")
		echo "$MSG"
		;;
	*)
		echo "$MSG_ERROR"
		;;
	esac
fi

